#!/usr/bin/python3
"""Omacanvas data helper for the native Omarchy bar plugin."""
from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
from datetime import datetime, timedelta, timezone
from html import unescape
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode, urljoin, urlparse
from urllib.request import HTTPRedirectHandler, Request, build_opener


SERVICE = "omacanvas"
PAYLOAD_VERSION = 5
VISIBILITY_VERSION = 1
MAX_RESPONSE_BYTES = 8 * 1024 * 1024
MAX_PAGES = 200
MAX_RECORDS = 20_000
MAX_FETCH_SECONDS = 180
REQUEST_TIMEOUT_SECONDS = 20
RECENT_ITEM_LIMIT = 3
ANNOUNCEMENT_EXCERPT_LENGTH = 180
MAX_CONVERSATION_PARTICIPANTS = 10


class CrossOriginRequestError(RuntimeError):
    """Raised before an authenticated request can leave the Canvas origin."""


class CanvasAuthenticationError(RuntimeError):
    """Raised when Canvas rejects the configured API token."""


class CanvasPermissionError(RuntimeError):
    """Raised when a valid token cannot access a Canvas resource."""


def _url_origin(url: str) -> tuple[str, str, int]:
    parsed = urlparse(url)
    if parsed.scheme.lower() != "https" or not parsed.hostname:
        raise CrossOriginRequestError("Canvas API requests must use HTTPS")
    if parsed.username is not None or parsed.password is not None:
        raise CrossOriginRequestError("Canvas API requests must not include URL credentials")
    try:
        port = parsed.port or 443
    except ValueError as error:
        raise CrossOriginRequestError("Canvas API request contains an invalid port") from error
    return parsed.scheme.lower(), parsed.hostname.lower(), port


def _require_same_origin(base_url: str, candidate_url: str) -> str:
    if _url_origin(base_url) != _url_origin(candidate_url):
        raise CrossOriginRequestError(
            "Canvas returned a redirect or pagination link outside the configured origin"
        )
    return candidate_url


class SameOriginRedirectHandler(HTTPRedirectHandler):
    def __init__(self, base_url: str):
        super().__init__()
        self.base_url = base_url

    def redirect_request(self, request, fp, code, message, headers, new_url):
        target = urljoin(request.full_url, new_url)
        _require_same_origin(self.base_url, target)
        return super().redirect_request(request, fp, code, message, headers, target)


def visibility_path() -> Path:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return config_home / "omacanvas" / "hidden-courses.json"


def normalize_instance_url(base_url: str) -> str:
    value = base_url.strip().rstrip("/")
    parsed = urlparse(value)
    if parsed.scheme.lower() != "https" or not parsed.netloc:
        raise RuntimeError(
            "Canvas URL must include https:// and a hostname "
            "(for example, https://canvas.example.edu)"
        )
    if parsed.username is not None or parsed.password is not None:
        raise RuntimeError("Canvas URL must not include a username or password")
    try:
        port = parsed.port
    except ValueError as error:
        raise RuntimeError("Canvas URL contains an invalid port") from error
    if parsed.path not in {"", "/"}:
        raise RuntimeError("Canvas URL must not include a path")
    if parsed.query or parsed.fragment:
        raise RuntimeError("Canvas URL must not include a query string or fragment")
    hostname = parsed.hostname
    if not hostname:
        raise RuntimeError("Canvas URL must include a hostname")
    try:
        hostname = hostname.encode("idna").decode("ascii").lower()
    except UnicodeError as error:
        raise RuntimeError("Canvas URL contains an invalid hostname") from error
    if ":" in hostname:
        hostname = f"[{hostname}]"
    netloc = hostname if port is None else f"{hostname}:{port}"
    return f"https://{netloc}"


def sanitize_text(value: Any, fallback: str = "") -> str:
    text = unescape(str(value if value is not None else fallback))
    text = "".join(
        " " if unicodedata.category(character) in {"Cc", "Cf"} else character
        for character in text
    )
    return " ".join(text.split()) or fallback


def validated_canvas_web_url(base_url: str, value: Any) -> str | None:
    if not isinstance(value, str) or not value.strip():
        return None
    if any(unicodedata.category(character) == "Cc" for character in value):
        return None
    candidate = urljoin(normalize_instance_url(base_url) + "/", value.strip())
    try:
        return _require_same_origin(base_url, candidate)
    except CrossOriginRequestError:
        return None


def canvas_course_web_url(base_url: str, course_id: Any) -> str | None:
    if isinstance(course_id, bool):
        return None
    course_key = str(course_id).strip()
    if not re.fullmatch(r"[0-9]+", course_key):
        return None
    return validated_canvas_web_url(base_url, f"/courses/{course_key}")


def _load_visibility(path: Path | None = None) -> dict[str, Any]:
    path = path or visibility_path()
    if path.is_symlink():
        raise RuntimeError("Hidden-course preferences must not be a symbolic link")
    if not path.exists():
        return {"version": VISIBILITY_VERSION, "instances": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"Could not read hidden-course preferences: {error}") from error
    if not isinstance(data, dict) or data.get("version") != VISIBILITY_VERSION:
        raise RuntimeError("Hidden-course preferences use an unsupported format")
    if not isinstance(data.get("instances"), dict):
        data["instances"] = {}
    return data


def hidden_courses_for(base_url: str, path: Path | None = None) -> dict[str, dict[str, str]]:
    data = _load_visibility(path)
    courses = data["instances"].get(normalize_instance_url(base_url), {})
    return courses if isinstance(courses, dict) else {}


def set_course_hidden(
    base_url: str,
    course_id: str,
    hidden: bool,
    name: str = "",
    code: str = "",
    path: Path | None = None,
) -> None:
    path = path or visibility_path()
    data = _load_visibility(path)
    instance_url = normalize_instance_url(base_url)
    instances = data["instances"]
    courses = instances.setdefault(instance_url, {})
    course_key = str(course_id)
    if hidden:
        courses[course_key] = {"name": name, "code": code}
    else:
        courses.pop(course_key, None)
        if not courses:
            instances.pop(instance_url, None)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    serialized = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(serialized)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _keyring_token(base_url: str) -> str | None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        return None
    instance_url = normalize_instance_url(base_url)
    try:
        result = subprocess.run(
            [secret_tool, "lookup", "service", SERVICE, "base_url", instance_url],
            check=False, capture_output=True, text=True, timeout=5,
        )
        token = result.stdout.strip()
        return token or None
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not read the Canvas token from the system keyring: {error}") from error


def get_token(base_url: str, token_from_environment: bool = False) -> str | None:
    if token_from_environment:
        return os.environ.get("CANVAS_API_KEY", "").strip() or None
    return _keyring_token(base_url)


def save_token(base_url: str, token: str) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to save a token; install libsecret")
    instance_url = normalize_instance_url(base_url)
    token = token.strip()
    if not token:
        raise RuntimeError("Canvas API token cannot be empty")
    hostname = urlparse(instance_url).netloc
    try:
        subprocess.run(
            [secret_tool, "store", f"--label=Omacanvas API token ({hostname})",
             "service", SERVICE, "base_url", instance_url],
            input=token + "\n", text=True, check=True,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not save the Canvas token in the system keyring: {error}") from error


def clear_token(base_url: str) -> None:
    secret_tool = secret_tool_path()
    if not secret_tool:
        raise RuntimeError("secret-tool is required to remove a saved token")
    instance_url = normalize_instance_url(base_url)
    try:
        subprocess.run(
            [secret_tool, "clear", "service", SERVICE, "base_url", instance_url],
            check=True, capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f"Could not remove the Canvas token from the system keyring: {error}") from error


def secret_tool_path() -> str | None:
    located = shutil.which("secret-tool")
    return str(Path(located).resolve()) if located else None


class CanvasClient:
    def __init__(self, base_url: str, token: str, opener=None, clock=None):
        self.base_url = normalize_instance_url(base_url) + "/"
        self.token = token
        self.opener = opener or build_opener(SameOriginRedirectHandler(self.base_url))
        self.clock = clock or time.monotonic
        self.deadline = self.clock() + MAX_FETCH_SECONDS

    def _request_timeout(self) -> float:
        remaining = self.deadline - self.clock()
        if remaining <= 0:
            raise RuntimeError("Canvas refresh exceeded the allowed duration")
        return min(REQUEST_TIMEOUT_SECONDS, remaining)

    def get_all(self, path: str, params: dict[str, Any] | None = None) -> list[dict[str, Any]]:
        url = urljoin(self.base_url, path.lstrip("/"))
        if params:
            url += "?" + urlencode(params, doseq=True)
        records: list[dict[str, Any]] = []
        visited: set[str] = set()
        while url:
            _require_same_origin(self.base_url, url)
            if url in visited:
                raise RuntimeError("Canvas pagination repeated a page")
            if len(visited) >= MAX_PAGES:
                raise RuntimeError("Canvas pagination exceeded the page limit")
            visited.add(url)
            request = Request(url, headers={"Authorization": f"Bearer {self.token}", "Accept": "application/json"})
            try:
                with self.opener.open(request, timeout=self._request_timeout()) as response:
                    raw = response.read(MAX_RESPONSE_BYTES + 1)
                    if len(raw) > MAX_RESPONSE_BYTES:
                        raise RuntimeError("Canvas API response exceeded the size limit")
                    page = json.loads(raw.decode("utf-8"))
                    if not isinstance(page, list) or not all(isinstance(item, dict) for item in page):
                        raise RuntimeError("Canvas API returned an unexpected response format")
                    if len(records) + len(page) > MAX_RECORDS:
                        raise RuntimeError("Canvas API response exceeded the record limit")
                    records.extend(page)
                    next_link = _next_link(response.headers.get("Link"))
                    url = _require_same_origin(self.base_url, urljoin(url, next_link)) if next_link else None
            except HTTPError as error:
                if error.code == 401:
                    raise CanvasAuthenticationError("Canvas rejected the API token") from error
                if error.code == 403:
                    raise CanvasPermissionError(
                        "Canvas denied access to data for this role"
                    ) from error
                raise RuntimeError(f"Canvas API returned HTTP {error.code}") from error
            except (URLError, TimeoutError, UnicodeDecodeError, json.JSONDecodeError) as error:
                raise RuntimeError(f"Could not reach Canvas: {error}") from error
        return records


def _next_link(header: str | None) -> str | None:
    if not header:
        return None
    for part in header.split(","):
        match = re.match(r"\s*<([^>]+)>\s*;\s*rel=\"?next\"?", part)
        if match:
            return match.group(1)
    return None


def parse_time(value: Any) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc)
    except (TypeError, ValueError):
        return None


def iso_time(value: Any) -> str | None:
    parsed = parse_time(value)
    return parsed.isoformat() if parsed is not None else None


def assignment_schedules(
    assignment: dict[str, Any],
    now: datetime,
    cutoff: datetime,
    include_all_dates: bool,
) -> list[dict[str, Any]]:
    date_records: list[dict[str, Any]] = []
    if include_all_dates and isinstance(assignment.get("all_dates"), list):
        date_records = [
            item for item in assignment["all_dates"] if isinstance(item, dict)
        ]
    if not any(parse_time(item.get("due_at")) for item in date_records):
        date_records = [assignment]

    schedules = []
    seen = set()
    for item in date_records:
        due = parse_time(item.get("due_at"))
        if due is None or not now <= due <= cutoff:
            continue
        schedule = {
            "due_at": due.isoformat(),
            "unlock_at": iso_time(item.get("unlock_at")),
            "lock_at": iso_time(item.get("lock_at")),
            "title": sanitize_text(item.get("title")) or None,
        }
        key = tuple(schedule.values())
        if key not in seen:
            schedules.append(schedule)
            seen.add(key)
    schedules.sort(key=lambda item: (
        item["due_at"], item["unlock_at"] or "", item["title"] or "",
    ))
    return schedules


def plain_text_excerpt(value: Any, limit: int = ANNOUNCEMENT_EXCERPT_LENGTH) -> str:
    text = sanitize_text(re.sub(r"<[^<>]*>", " ", str(value or "")))
    if len(text) > limit:
        text = text[: max(0, limit - 1)].rstrip() + "…"
    return text


def collect_announcements(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every announcement for a course, newest first.

    The full list is kept in the payload so external tools can process it;
    the panel displays only a recent subset.
    """
    try:
        topics = client.get_all(
            f"api/v1/courses/{course_id}/discussion_topics",
            {"only_announcements": "true", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for topic in topics:
        if not isinstance(topic, dict):
            continue
        posted = parse_time(topic.get("posted_at")) or parse_time(topic.get("created_at"))
        author = topic.get("author")
        author_name = sanitize_text(
            author.get("display_name") if isinstance(author, dict) else None
        )
        scored.append((
            posted or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": topic.get("id"),
                "title": sanitize_text(topic.get("title"), "Untitled announcement"),
                "posted_at": posted.isoformat() if posted is not None else None,
                "author": author_name or None,
                "excerpt": plain_text_excerpt(topic.get("message")),
                "html_url": validated_canvas_web_url(
                    client.base_url, topic.get("html_url"),
                ),
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def collect_discussions(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every discussion topic for a course, most active first.

    Announcements are excluded by the API when only_announcements is absent.
    The full list is kept in the payload so external tools can process it;
    the panel displays only a recent subset.
    """
    try:
        topics = client.get_all(
            f"api/v1/courses/{course_id}/discussion_topics",
            {"order_by": "recent_activity", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for topic in topics:
        if not isinstance(topic, dict):
            continue
        activity = (
            parse_time(topic.get("last_reply_at"))
            or parse_time(topic.get("posted_at"))
            or parse_time(topic.get("created_at"))
        )
        posted = parse_time(topic.get("posted_at")) or parse_time(topic.get("created_at"))
        author = topic.get("author")
        if isinstance(author, dict):
            author_name = sanitize_text(author.get("display_name"))
        else:
            author_name = sanitize_text(topic.get("user_name"))
        reply_count = topic.get("discussion_subentry_count")
        if not isinstance(reply_count, int) or isinstance(reply_count, bool):
            reply_count = 0
        scored.append((
            activity or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": topic.get("id"),
                "title": sanitize_text(topic.get("title"), "Untitled discussion"),
                "posted_at": posted.isoformat() if posted is not None else None,
                "last_activity_at": activity.isoformat() if activity is not None else None,
                "author": author_name or None,
                "reply_count": reply_count,
                "pinned": topic.get("pinned") is True,
                "locked": topic.get("locked") is True,
                "excerpt": plain_text_excerpt(topic.get("message")),
                "html_url": validated_canvas_web_url(
                    client.base_url, topic.get("html_url"),
                ),
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def collect_conversations(
    client: CanvasClient,
    course_id: Any,
) -> list[dict[str, Any]]:
    """Return every conversation for a course, newest first.

    The full list is kept in the payload so external tools can process it;
    the panel displays only unread conversations.
    """
    try:
        records = client.get_all(
            "api/v1/conversations",
            {"filter": f"course_{course_id}", "per_page": 100},
        )
    except CanvasPermissionError:
        return []
    inbox_url = validated_canvas_web_url(client.base_url, "/conversations")
    scored: list[tuple[datetime, dict[str, Any]]] = []
    for record in records:
        if not isinstance(record, dict):
            continue
        sent_at = parse_time(record.get("last_message_at"))
        participants: list[dict[str, Any]] = []
        seen_participants = set()
        for participant in record.get("participants") or []:
            if not isinstance(participant, dict) or participant.get("id") in seen_participants:
                continue
            seen_participants.add(participant.get("id"))
            participants.append({
                "id": participant.get("id"),
                "name": sanitize_text(participant.get("name"), "Unknown"),
            })
            if len(participants) >= MAX_CONVERSATION_PARTICIPANTS:
                break
        message_count = record.get("message_count")
        if not isinstance(message_count, int) or isinstance(message_count, bool):
            message_count = 0
        scored.append((
            sent_at or datetime.min.replace(tzinfo=timezone.utc),
            {
                "id": record.get("id"),
                "subject": sanitize_text(record.get("subject"), "No subject"),
                "workflow_state": record.get("workflow_state"),
                "unread": record.get("workflow_state") == "unread",
                "last_message_at": sent_at.isoformat() if sent_at is not None else None,
                "last_message": plain_text_excerpt(record.get("last_message")),
                "message_count": message_count,
                "starred": record.get("starred") is True,
                "participants": participants,
                "context_name": sanitize_text(record.get("context_name")) or None,
                "html_url": inbox_url,
            },
        ))
    scored.sort(key=lambda item: item[0], reverse=True)
    return [item for _, item in scored]


def empty_role_payload(error: str = "") -> dict[str, Any]:
    return {
        "available": False,
        "error": error,
        "courses": [],
        "hidden_courses": [],
    }


def collect_role(
    client: CanvasClient,
    role: str,
    days: int = 14,
    now: datetime | None = None,
    hidden_course_ids: set[str] | None = None,
) -> dict[str, Any]:
    if role not in {"student", "teacher"}:
        raise ValueError(f"Unsupported Canvas role: {role}")
    now = now or datetime.now(timezone.utc)
    cutoff = now + timedelta(days=days)
    hidden_course_ids = hidden_course_ids or set()
    include = "total_scores" if role == "student" else "needs_grading_count"
    courses = client.get_all("api/v1/courses", {
        "enrollment_state": "active", "enrollment_type": role,
        "include[]": [include], "per_page": 100,
    })
    result_courses = []
    hidden_courses = []
    enrollment_types = {
        "student": {"student", "studentenrollment"},
        "teacher": {"teacher", "teacherenrollment"},
    }[role]
    for course in courses:
        if not course.get("id") or course.get("access_restricted_by_date"):
            continue
        enrollments = course.get("enrollments") or []
        enrollment = next(
            (item for item in enrollments
             if str(item.get("type", "")).lower() in enrollment_types),
            None,
        )
        if enrollments and enrollment is None:
            continue
        course_name = sanitize_text(course.get("name"), "Unnamed course")
        course_code = sanitize_text(course.get("course_code"))
        if str(course["id"]) in hidden_course_ids:
            hidden_courses.append({
                "id": course["id"], "name": course_name,
                "code": course_code,
            })
            continue
        assignment_includes = ["submission"] if role == "student" else ["all_dates"]
        assignments = client.get_all(f"api/v1/courses/{course['id']}/assignments", {
            "include[]": assignment_includes, "order_by": "due_at", "per_page": 100,
        })
        upcoming = []
        for assignment in assignments:
            schedules = assignment_schedules(
                assignment, now, cutoff, include_all_dates=role == "teacher",
            )
            if not schedules:
                continue
            due_dates = sorted({schedule["due_at"] for schedule in schedules})
            submission = assignment.get("submission") or {}
            published = assignment.get("published")
            upcoming.append({
                "id": assignment.get("id"),
                "name": sanitize_text(assignment.get("name"), "Untitled"),
                "due_at": due_dates[0],
                "due_dates": due_dates,
                "availability_schedules": schedules,
                "submitted": role == "student" and submission.get("submitted_at") is not None,
                "published": published if isinstance(published, bool) else None,
                "locked_for_user": role == "student" and assignment.get("locked_for_user") is True,
                "unlock_at": iso_time(assignment.get("unlock_at")),
                "lock_at": iso_time(assignment.get("lock_at")),
                "html_url": validated_canvas_web_url(
                    client.base_url, assignment.get("html_url"),
                ),
            })
        upcoming.sort(key=lambda item: item["due_at"])
        announcements = collect_announcements(client, course["id"])
        conversations = collect_conversations(client, course["id"])
        discussions = collect_discussions(client, course["id"])
        current_score = enrollment.get("computed_current_score") if enrollment else None
        current_grade = enrollment.get("computed_current_grade") if enrollment else None
        current_grade = (
            sanitize_text(current_grade) or None if role == "student" else None
        )
        needs_grading = course.get("needs_grading_count", 0)
        if not isinstance(needs_grading, int) or isinstance(needs_grading, bool):
            needs_grading = 0
        result_courses.append({
            "id": course["id"], "name": course_name,
            "code": course_code,
            "html_url": canvas_course_web_url(client.base_url, course["id"]),
            "workflow_state": sanitize_text(course.get("workflow_state")) or None,
            "current_score": current_score if role == "student" else None,
            "current_grade": current_grade,
            "needs_grading_count": needs_grading if role == "teacher" else 0,
            "assignments": upcoming,
            "announcements": announcements,
            "conversations": conversations,
            "discussions": discussions,
        })
    result_courses.sort(key=lambda item: item["name"].lower())
    hidden_courses.sort(key=lambda item: item["name"].lower())
    return {
        "available": bool(result_courses or hidden_courses),
        "error": "",
        "courses": result_courses,
        "hidden_courses": hidden_courses,
    }


def collect(
    client: CanvasClient,
    days: int = 14,
    now: datetime | None = None,
    hidden_course_ids: set[str] | None = None,
) -> dict[str, Any]:
    now = now or datetime.now(timezone.utc)
    roles = {}
    for role in ("student", "teacher"):
        try:
            roles[role] = collect_role(
                client, role, days, now, hidden_course_ids,
            )
        except CanvasPermissionError as error:
            roles[role] = empty_role_payload(str(error))
    return {
        "schema_version": PAYLOAD_VERSION,
        "fetched_at": now.isoformat(),
        "days": days,
        "roles": roles,
    }


def print_terminal(data: dict[str, Any]) -> None:
    print(f"Canvas — assignments due in the next {data['days']} days")
    for role, heading in (("student", "Student"), ("teacher", "Teaching")):
        role_data = data["roles"][role]
        print(f"\n{heading}")
        if role_data["error"]:
            print(f"  {role_data['error']}")
            continue
        if not role_data["courses"]:
            print("  No active courses found.")
            continue
        for course in role_data["courses"]:
            if role == "student":
                detail = course["current_grade"] or (
                    f"{course['current_score']:.1f}%"
                    if isinstance(course["current_score"], (int, float)) else "—"
                )
            else:
                detail = f"{course['needs_grading_count']} need grading"
            print(f"\n{course['name']} ({detail})")
            for assignment in course["assignments"]:
                if role == "student":
                    status = "submitted" if assignment["submitted"] else "TODO"
                else:
                    status = (
                        "published" if assignment["published"] is True
                        else "draft" if assignment["published"] is False
                        else "unknown"
                    )
                print(f"  [{status:9}] {assignment['due_at'][:10]}  {assignment['name']}")
            for announcement in (course.get("announcements") or [])[:RECENT_ITEM_LIMIT]:
                posted = (announcement.get("posted_at") or "")[:10] or "no date"
                print(f"  [announce ] {posted}  {announcement.get('title', 'Untitled announcement')}")
            unread = [c for c in course.get("conversations") or [] if c.get("unread")]
            for conversation in unread[:RECENT_ITEM_LIMIT]:
                sent = (conversation.get("last_message_at") or "")[:10] or "no date"
                print(f"  [unread   ] {sent}  {conversation.get('subject', 'No subject')}")
            for discussion in (course.get("discussions") or [])[:RECENT_ITEM_LIMIT]:
                active = (discussion.get("last_activity_at") or "")[:10] or "no date"
                print(f"  [discuss  ] {active}  {discussion.get('title', 'Untitled discussion')}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=["fetch", "set-token", "clear-token", "hide-course", "unhide-course"])
    parser.add_argument("course_id", nargs="?")
    parser.add_argument("--days", type=int, default=14)
    parser.add_argument("--json", action="store_true", dest="as_json")
    parser.add_argument(
        "--token-from-env", action="store_true",
        help="read CANVAS_API_KEY instead of the URL-scoped system keyring",
    )
    parser.add_argument("--course-name", default="")
    parser.add_argument("--course-code", default="")
    parser.add_argument(
        "--base-url", default="",
        help="Canvas installation URL; defaults to CANVAS_BASE_URL",
    )
    args = parser.parse_args()
    try:
        raw_base_url = args.base_url or os.environ.get("CANVAS_BASE_URL", "")
        if not raw_base_url:
            raise RuntimeError(
                "Set a Canvas URL with --base-url or CANVAS_BASE_URL "
                "(for example, https://canvas.example.edu)"
            )
        base_url = normalize_instance_url(raw_base_url)
        if args.command == "set-token":
            save_token(base_url, getpass.getpass(f"Canvas API token for {base_url}: "))
            print(f"Canvas token saved in the system keyring for {base_url}.")
            return 0
        if args.command == "clear-token":
            clear_token(base_url)
            print(f"Canvas token removed from the system keyring for {base_url}.")
            return 0
        if args.command in {"hide-course", "unhide-course"}:
            if not args.course_id:
                raise RuntimeError("A course ID is required")
            hidden = args.command == "hide-course"
            set_course_hidden(base_url, args.course_id, hidden, args.course_name, args.course_code)
            print("Course hidden." if hidden else "Course unhidden.")
            return 0
        token = get_token(base_url, args.token_from_env)
        if not token:
            if args.token_from_env:
                raise RuntimeError("CANVAS_API_KEY is empty")
            raise RuntimeError(
                f"No Canvas API token is saved for {base_url}. "
                f"Run 'omacanvas set-token --base-url {base_url}'"
            )
        hidden_ids = set(hidden_courses_for(base_url))
        data = collect(CanvasClient(base_url, token), max(1, args.days), hidden_course_ids=hidden_ids)
        if args.as_json:
            print(json.dumps(data, indent=2, ensure_ascii=False))
        else:
            print_terminal(data)
        return 0
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print(f"omacanvas: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
